{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SmartHub",
  "version": "0.1.0",
  "identifier": "com.smarthub.client",
  "build": {
    "frontendDist": "../../static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SmartHub",
        "width": 420,
        "height": 840,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
